# 複製成 .env 再修改（.env 不要 commit：裡面有密碼）
#   cp .env.example .env

# 資料庫密碼
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-shop

# JWT 簽章金鑰：至少 32 個字元的亂數，例如 openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# 瀏覽器開網站用的網址（綠界付款完會帶使用者回到這裡）
PUBLIC_URL=http://localhost
WEB_PORT=80

# 綠界要「從外面」連得到的網址（付款結果通知 ReturnURL）
#   本機測試：cloudflared tunnel --url http://localhost:80，把拿到的 https://xxx.trycloudflare.com 填在這裡
#   雲端主機：填正式網域，例如 https://shop.example.com
ECPAY_PUBLIC_URL=http://localhost

# 綠界測試環境（官方文件公開的測試特店）；正式上線換成自己的特店資料
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# prod：正式模式；dev：多開「模擬付款」按鈕（上課沒有 tunnel 時用）
SPRING_PROFILES_ACTIVE=prod
